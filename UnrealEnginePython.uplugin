{
	"FileVersion": 3,
	"Version": 1000,
	"VersionName": "1.0.0-rc.1",
	"FriendlyName": "UnrealEnginePython",
	"Description": "Unreal Engine 5.8.1 and CPython 3.11 bindings and runtime integration",
	"Category": "Scripting Languages",
	"CreatedBy": "Roberto De Ioris",
	"CreatedByURL": "",
	"DocsURL": "https://github.com/Arcueid77/UnrealEnginePython5#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/Arcueid77/UnrealEnginePython5/issues",
	"EnabledByDefault": true,
	"CanContainContent": true,
	"IsBetaVersion": true,
	"Installed": false,
  "Modules": [
    {
      "Name": "UnrealEnginePython",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "PythonAutomation",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    },
    {
      "Name": "PythonConsole",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    },
    {
      "Name": "PythonEditor",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    }
  ],
  "Plugins": [
    {
      "Name": "EnhancedInput",
      "Enabled": true
    },
    {
      "Name": "LevelSequenceEditor",
      "Enabled": true
    }
  ]
}
